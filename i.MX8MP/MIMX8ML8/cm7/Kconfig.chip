# core related
config MCUX_HW_CORE
    string
    default "cm7f"

config MCUX_HW_CORE_CM7F
    bool
    default y

config MCUX_HW_CORE_ID
    string
    default "cm7"

config MCUX_HW_CORE_ID_CM7
    bool
    default y

config MCUX_HW_DEVICE_CORE
    string
    default "MIMX8ML8_cm7"

config MCUX_HW_FPU
    string
    default "SP_FPU"

config MCUX_HW_FPU_TYPE
    string
    default "fpv5_dp"

config MCUX_HW_FPV5_DP
    bool
    default y

config MCUX_HW_INT_PRIO_BITS
    int
    default 4

config MCUX_HW_SOC_SERIES_MIMX
    bool
    default y

config MCUX_HW_SOC_SINGLECORE_DEVICE
    bool
    default y

# For chipmodel generated files
config MCUX_TOOLCHAIN_LINKER_DEVICE_PREFIX
    string
    default "MIMX8ML8xxxLZ" if MCUX_HW_DEVICE_ID_MIMX8ML8xxxLZ
    default "MIMX8ML8xxxKZ" if MCUX_HW_DEVICE_ID_MIMX8ML8xxxKZ

config MCUX_TOOLCHAIN_MCUX_STARTUP
    string
    default "mimx8ml8"

# Toolchain related

config MCUX_TOOLCHAIN_IAR_CPU_IDENTIFIER
    string
    default "MIMX8ML8_M7" if MCUX_HW_DEVICE_ID_MIMX8ML8xxxLZ
    default "MIMX8ML8_M7" if MCUX_HW_DEVICE_ID_MIMX8ML8xxxKZ

config MCUX_TOOLCHAIN_MDK_CPU_IDENTIFIER
    string
    default "MIMX8ML8DVNLZ" if MCUX_HW_DEVICE_PART_MIMX8ML8DVNLZ
    default "MIMX8ML8CVNKZ" if MCUX_HW_DEVICE_PART_MIMX8ML8CVNKZ
