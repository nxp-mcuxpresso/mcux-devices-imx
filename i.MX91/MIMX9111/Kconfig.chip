# device related

config MCUX_HW_DEVICE_ID_MIMX9111xxxxx
    bool

choice MCUX_HW_DEVICE_PART_MIMX9111
    prompt "Device MIMX9111 Part"
    config MCUX_HW_DEVICE_PART_MIMX9111CVXXJ
    bool "MIMX9111CVXXJ"
    select MCUX_HW_DEVICE_ID_MIMX9111xxxxx
    config MCUX_HW_DEVICE_PART_MIMX9111DVXXJ
    bool "MIMX9111DVXXJ"
    select MCUX_HW_DEVICE_ID_MIMX9111xxxxx
endchoice

config MCUX_HW_DEVICE_ID
    string
    default "MIMX9111xxxxx" if MCUX_HW_DEVICE_ID_MIMX9111xxxxx

config MCUX_HW_DEVICE_PART
    string
    default "MIMX9111CVXXJ" if MCUX_HW_DEVICE_PART_MIMX9111CVXXJ
    default "MIMX9111DVXXJ" if MCUX_HW_DEVICE_PART_MIMX9111DVXXJ

