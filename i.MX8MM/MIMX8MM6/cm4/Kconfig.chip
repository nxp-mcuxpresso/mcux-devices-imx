# core related
config MCUX_HW_CORE
    string
    default "cm4f"

config MCUX_HW_CORE_CM4F
    bool
    default y

config MCUX_HW_CORE_ID
    string
    default "cm4"

config MCUX_HW_CORE_ID_CM4
    bool
    default y

config MCUX_HW_DEVICE_CORE
    string
    default "MIMX8MM6_cm4"

config MCUX_HW_FPU
    string
    default "SP_FPU"

config MCUX_HW_FPU_TYPE
    string
    default "fpv4_sp"

config MCUX_HW_FPV4_SP
    bool
    default y

config MCUX_HW_INT_PRIO_BITS
    int
    default 4

config MCUX_HW_SOC_SERIES_MIMX
    bool
    default y

config MCUX_HW_SOC_SINGLECORE_DEVICE
    bool
    default y

# For chipmodel generated files
config MCUX_TOOLCHAIN_LINKER_DEVICE_PREFIX
    string
    default "MIMX8MM6xxxLZ" if MCUX_HW_DEVICE_ID_MIMX8MM6xxxLZ
    default "MIMX8MM6xxxKZ" if MCUX_HW_DEVICE_ID_MIMX8MM6xxxKZ

config MCUX_TOOLCHAIN_MCUX_STARTUP
    string
    default "mimx8mm6"

# Toolchain related

config MCUX_TOOLCHAIN_IAR_CPU_IDENTIFIER
    string
    default "MIMX8MM6_M4" if MCUX_HW_DEVICE_ID_MIMX8MM6xxxLZ
    default "MIMX8MM6_M4" if MCUX_HW_DEVICE_ID_MIMX8MM6xxxKZ

config MCUX_TOOLCHAIN_MDK_CPU_IDENTIFIER
    string
    default "MIMX8MM6DVTLZ" if MCUX_HW_DEVICE_PART_MIMX8MM6DVTLZ
    default "MIMX8MM6CVTKZ" if MCUX_HW_DEVICE_PART_MIMX8MM6CVTKZ
