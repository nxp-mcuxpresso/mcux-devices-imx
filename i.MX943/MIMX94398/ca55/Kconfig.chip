# core related
config MCUX_HW_CORE
    string
    default "ca55"

config MCUX_HW_CORE_CA55
    bool
    default y

config MCUX_HW_CORE_ID
    string
    default "ca55"

config MCUX_HW_CORE_ID_CA55
    bool
    default y

config MCUX_HW_DEVICE_CORE
    string
    default "MIMX94398_ca55"

config MCUX_HW_SOC_SERIES_MIMX
    bool
    default y

# For chipmodel generated files
config MCUX_TOOLCHAIN_LINKER_DEVICE_PREFIX
    string
    default "MIMX94398xxxM" if MCUX_HW_DEVICE_ID_MIMX94398xxxM
    default "MIMX94398xxxJ" if MCUX_HW_DEVICE_ID_MIMX94398xxxJ
    default "MIMX94398xxxE" if MCUX_HW_DEVICE_ID_MIMX94398xxxE

