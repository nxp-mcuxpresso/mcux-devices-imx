# core related
config MCUX_HW_CORE
    string
    default "cm33"

config MCUX_HW_CORE_CM33
    bool
    default y

config MCUX_HW_CORE_ID
    string
    default "cm33_core1"

config MCUX_HW_CORE_ID_CM33_CORE1
    bool
    default y

config MCUX_HW_DEVICE_CORE
    string
    default "MIMX94398_cm33_core1"

config MCUX_HW_FPU
    string
    default "SP_FPU"

config MCUX_HW_FPU_TYPE
    string
    default "fpv5_sp"

config MCUX_HW_FPV5_SP
    bool
    default y

config MCUX_HW_INT_PRIO_BITS
    int
    help
        The value of the option must be equal to the value of the macro "__NVIC_PRIO_BITS" in CMSIS Header files.
    default 4

config MCUX_HW_DSP
    bool
    default y

config MCUX_HW_SAU
    bool
    default y

config MCUX_HW_SOC_SERIES_MIMX
    bool
    default y

# For chipmodel generated files
config MCUX_TOOLCHAIN_LINKER_DEVICE_PREFIX
    string
    default "MIMX94398_cm33_core1" if MCUX_HW_DEVICE_ID_MIMX94398xxxM
    default "MIMX94398_cm33_core1" if MCUX_HW_DEVICE_ID_MIMX94398xxxJ
    default "MIMX94398_cm33_core1" if MCUX_HW_DEVICE_ID_MIMX94398xxxE

config MCUX_TOOLCHAIN_MCUX_STARTUP
    string
    default "mimx9494_cm33_core1"

# Toolchain related

config MCUX_TOOLCHAIN_IAR_CPU_IDENTIFIER
    string
    default "MIMX94398xxxM_cm33_core1" if MCUX_HW_DEVICE_ID_MIMX94398xxxM
    default "MIMX94398xxxJ_cm33_core1" if MCUX_HW_DEVICE_ID_MIMX94398xxxJ
    default "MIMX94398xxxE_cm33_core1" if MCUX_HW_DEVICE_ID_MIMX94398xxxE

