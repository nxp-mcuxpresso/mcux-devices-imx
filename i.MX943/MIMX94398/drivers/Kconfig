rsource "${core_id}/Kconfig"

menu "Device specific drivers configuration"

    config MCUX_COMPONENT_driver.elec_spec
         bool "elec_spec"
         default y

    config MCUX_COMPONENT_driver.reset
         bool "reset"
         default y

    config MCUX_COMPONENT_driver.trdc_soc
         bool "trdc_soc"
         default n

    config MCUX_COMPONENT_driver.clock
         bool "clock"
         default y

    config MCUX_COMPONENT_driver.edma_soc
         bool "edma_soc"
         depends on MCUX_COMPONENT_driver.edma4
         default y

    config MCUX_COMPONENT_driver.iomuxc
         bool "iomuxc"
         default y

    config MCUX_COMPONENT_driver.supply
         bool "supply"
         default n

    config MCUX_COMPONENT_driver.cpu
         bool "cpu"
         default n

    config MCUX_COMPONENT_driver.memory
         bool "memory"
         default y

    config MCUX_COMPONENT_driver.power
         bool "power"
         default y

    config MCUX_COMPONENT_driver.ccm
         bool "ccm"
         default n

    config MCUX_COMPONENT_driver.src1
         bool "src1"
         default n

    config MCUX_COMPONENT_driver.fro
         bool "fro"
         default n
endmenu
