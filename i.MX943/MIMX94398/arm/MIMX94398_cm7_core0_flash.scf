#if (defined(__ram_vector_table__))
  #define __ram_vector_table_size__    0x00000620
#else
  #define __ram_vector_table_size__    0x00000000
#endif

#define m_interrupts_start             0x28032000
#define m_interrupts_size              0x00002000

#define m_text_start                   0x28034000
#define m_text_size                    0x003CC000

#define m_interrupts_ram_start         0x20003000
#define m_interrupts_ram_size          __ram_vector_table_size__

#define m_data_start                   (m_interrupts_ram_start + m_interrupts_ram_size)
#define m_data_size                    (0x0001D000 - m_interrupts_ram_size)


/* Sizes */
#if (defined(__stack_size__))
  #define Stack_Size                   __stack_size__
#else
  #define Stack_Size                   0x0400
#endif

#if (defined(__heap_size__))
  #define Heap_Size                    __heap_size__
#else
  #define Heap_Size                    0x0400
#endif

LR_m_interrupts m_interrupts_start m_interrupts_size {   ; vector table load region (root)
  VECTOR_ROM m_interrupts_start m_interrupts_size { ; load address = execution address
    * (.isr_vector,+FIRST)
  }
}

LR_m_text m_text_start m_text_size+m_data_size {   ; code + RW load region
  ER_m_text m_text_start m_text_size { ; load address = execution address (root)
    * (InRoot$$Sections)
    * (.resource_table)
    * (CodeQuickAccess)
    .ANY (+RO)
  }

  RW_m_interrupts_ram m_interrupts_ram_start EMPTY m_interrupts_ram_size { ; relocated vector table
  }

  RW_m_data m_data_start m_data_size-Stack_Size-Heap_Size { ; RW/ZI data
    * (DataQuickAccess)
    .ANY (+RW +ZI)
  }

  ARM_LIB_HEAP +0 EMPTY Heap_Size {    ; heap region growing up
  }

  ARM_LIB_STACK m_data_start+m_data_size EMPTY -Stack_Size { ; stack region growing down
  }
}
