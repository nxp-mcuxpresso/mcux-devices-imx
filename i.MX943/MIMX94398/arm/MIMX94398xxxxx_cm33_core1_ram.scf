#if (defined(__ram_vector_table__))
  #define __ram_vector_table_size__    0x00000620
#else
  #define __ram_vector_table_size__    0x00000000
#endif

#define m_interrupts_start             0x0FFC0000
#define m_interrupts_size              0x00002000

#define m_text_start                   0x0FFC2000
#define m_text_size                    0x0003E000

#define m_interrupts_ram_start         0x20003000
#define m_interrupts_ram_size          __ram_vector_table_size__

#define m_data_start                   (m_interrupts_ram_start + m_interrupts_ram_size)
#define m_data_size                    (0x0002B000 - m_interrupts_ram_size)

#define m_ncache_start                 0x2002E000
#define m_ncache_size                  0x0000B000

#define m_rpmsg_shmem_m70_m33s_start   0x20039000
#define m_rpmsg_shmem_m70_m33s_size    0x00001800

#define m_rpmsg_shmem_m71_m33s_start   0x2003A800
#define m_rpmsg_shmem_m71_m33s_size    0x00001800

#define m_rsc_tbl_start                0x2003C000
#define m_rsc_tbl_size                 0x00004000

#define m_rsc_tbl_share_with_mpu_start 0x208A0000
#define m_rsc_tbl_share_with_mpu_size  0x00001000

#if (defined(__stack_size__))
  #define Stack_Size                   __stack_size__
#else
  #define Stack_Size                   0x0400
#endif

#if (defined(__heap_size__))
  #define Heap_Size                    __heap_size__
#else
  #define Heap_Size                    0x0400
#endif

LR_m_interrupts m_interrupts_start FIXED m_interrupts_size {
  VECTOR_ROM m_interrupts_start FIXED m_interrupts_size {
    * (.isr_vector, +FIRST)
  }
}

LR_m_text m_text_start FIXED m_text_size {
  ER_m_text m_text_start FIXED m_text_size {
    * (InRoot$$Sections)
    * (.resource_table)
    * (CodeQuickAccess)
    .ANY (+RO)
  }
}

; ===========================================================================
; LR_m_data: RW data - LMA placed right after the code image
;   (AlignExpr(ImageLimit(LR_m_text), 8)), VMA = DTCM.
;   The code TCM region is only m_text_size large starting at
;   m_interrupts_start; flash.bin is copied as one contiguous blob into TCM,
;   so a RW init image LMA pinned at (m_text_start + m_text_size) would sit at
;   the region boundary and never be loaded by flash.bin; at startup
;   __scatterload_copy would read that source address and HardFault. Placing
;   the LMA at ImageLimit(LR_m_text) keeps the RW init image inside the loaded
;   code image. The LMA is 8-byte aligned because armlink requires a load
;   region base to be 8-byte aligned (L6244E).
; ===========================================================================
LR_m_data AlignExpr(ImageLimit(LR_m_text), 8) {
  RW_m_interrupts_ram m_interrupts_ram_start EMPTY m_interrupts_ram_size {
  }
  RW_m_data m_data_start (m_data_size - Stack_Size - Heap_Size) {
    * (DataQuickAccess)
    .ANY (+RW +ZI)
  }
  ARM_LIB_HEAP  +0 ALIGN 8 EMPTY Heap_Size {
  }
  ARM_LIB_STACK (m_data_start + m_data_size) EMPTY -Stack_Size {
  }
}

LR_m_ncache m_ncache_start m_ncache_size {
  RW_m_ncache m_ncache_start m_ncache_size {
    * (NonCacheable.init)
    * (*NonCacheable)
  }
  RW_m_ncache_unused +0 EMPTY (m_ncache_size - ImageLength(RW_m_ncache)) {
  }
}

LR_m_rpmsg_shmem_m70_m33s m_rpmsg_shmem_m70_m33s_start m_rpmsg_shmem_m70_m33s_size {
  RW_m_rpmsg_shmem_m70_m33s m_rpmsg_shmem_m70_m33s_start m_rpmsg_shmem_m70_m33s_size {
    * (m_rpmsg_shmem_m70_m33s)
  }
}

LR_m_rpmsg_shmem_m71_m33s m_rpmsg_shmem_m71_m33s_start m_rpmsg_shmem_m71_m33s_size {
  RW_m_rpmsg_shmem_m71_m33s m_rpmsg_shmem_m71_m33s_start m_rpmsg_shmem_m71_m33s_size {
    * (m_rpmsg_shmem_m71_m33s)
  }
}

LR_m_rsc_tbl m_rsc_tbl_start m_rsc_tbl_size {
  RW_m_rsc_tbl m_rsc_tbl_start m_rsc_tbl_size {
    * (m_rsc_tbl)
  }
}

LR_m_rsc_tbl_share_with_mpu m_rsc_tbl_share_with_mpu_start m_rsc_tbl_share_with_mpu_size {
  RW_m_rsc_tbl_share_with_mpu m_rsc_tbl_share_with_mpu_start m_rsc_tbl_share_with_mpu_size {
    * (m_rsc_tbl_share_with_mpu)
  }
}
