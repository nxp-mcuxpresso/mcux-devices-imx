# core related
config MCUX_HW_CORE
    string
    default "cm7f"

config MCUX_HW_CORE_CM7F
    bool
    default y

config MCUX_HW_CORE_ID
    string
    default "cm7_core1"

config MCUX_HW_CORE_ID_CM7_CORE1
    bool
    default y

config MCUX_HW_DEVICE_CORE
    string
    default "MIMX94398_cm7_core1"

config MCUX_HW_FPU
    string
    default "DP_FPU"

config MCUX_HW_FPU_TYPE
    string
    default "fpv5_dp"

config MCUX_HW_FPV5_DP
    bool
    default y

config MCUX_HW_INT_PRIO_BITS
    int
    default 4

config MCUX_HW_SOC_SERIES_MIMX
    bool
    default y

# For chipmodel generated files
config MCUX_TOOLCHAIN_LINKER_DEVICE_PREFIX
    string
    default "MIMX94398_cm7_core1" if MCUX_HW_DEVICE_ID_MIMX94398xxxM
    default "MIMX94398_cm7_core1" if MCUX_HW_DEVICE_ID_MIMX94398xxxJ
    default "MIMX94398_cm7_core1" if MCUX_HW_DEVICE_ID_MIMX94398xxxE

config MCUX_TOOLCHAIN_MCUX_STARTUP
    string
    default "mimx9494_cm7_core1"

# Toolchain related

config MCUX_TOOLCHAIN_IAR_CPU_IDENTIFIER
    string
    default "MIMX94398xxxM_cm7_core1" if MCUX_HW_DEVICE_ID_MIMX94398xxxM
    default "MIMX94398xxxJ_cm7_core1" if MCUX_HW_DEVICE_ID_MIMX94398xxxJ
    default "MIMX94398xxxE_cm7_core1" if MCUX_HW_DEVICE_ID_MIMX94398xxxE

