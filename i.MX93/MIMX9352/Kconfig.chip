# device related

config MCUX_HW_DEVICE_ID_MIMX9352xxxxM
    bool

choice MCUX_HW_DEVICE_PART_MIMX9352
    prompt "Device MIMX9352 Part"
    config MCUX_HW_DEVICE_PART_MIMX9352DVVXM
    bool "MIMX9352DVVXM"
    select MCUX_HW_DEVICE_ID_MIMX9352xxxxM
    config MCUX_HW_DEVICE_PART_MIMX9352AVTXM
    bool "MIMX9352AVTXM"
    select MCUX_HW_DEVICE_ID_MIMX9352xxxxM
    config MCUX_HW_DEVICE_PART_MIMX9352CVVXM
    bool "MIMX9352CVVXM"
    select MCUX_HW_DEVICE_ID_MIMX9352xxxxM
    config MCUX_HW_DEVICE_PART_MIMX9352XVVXM
    bool "MIMX9352XVVXM"
    select MCUX_HW_DEVICE_ID_MIMX9352xxxxM
endchoice

config MCUX_HW_DEVICE_ID
    string
    default "MIMX9352xxxxM" if MCUX_HW_DEVICE_ID_MIMX9352xxxxM

config MCUX_HW_DEVICE_PART
    string
    default "MIMX9352DVVXM" if MCUX_HW_DEVICE_PART_MIMX9352DVVXM
    default "MIMX9352AVTXM" if MCUX_HW_DEVICE_PART_MIMX9352AVTXM
    default "MIMX9352CVVXM" if MCUX_HW_DEVICE_PART_MIMX9352CVVXM
    default "MIMX9352XVVXM" if MCUX_HW_DEVICE_PART_MIMX9352XVVXM

