# device related

config MCUX_HW_DEVICE_ID_MIMX9596xxxxQ
    bool

config MCUX_HW_DEVICE_ID_MIMX9596xxxxN
    bool

config MCUX_HW_DEVICE_ID_MIMX9596xxxxL
    bool

choice MCUX_HW_DEVICE_PART_MIMX9596
    prompt "Device MIMX9596 Part"
    config MCUX_HW_DEVICE_PART_MIMX9596AVZXN
    bool "MIMX9596AVZXN"
    select MCUX_HW_DEVICE_ID_MIMX9596xxxxN
    config MCUX_HW_DEVICE_PART_MIMX9596XVZXN
    bool "MIMX9596XVZXN"
    select MCUX_HW_DEVICE_ID_MIMX9596xxxxN
    config MCUX_HW_DEVICE_PART_MIMX9596XVTXN
    bool "MIMX9596XVTXN"
    select MCUX_HW_DEVICE_ID_MIMX9596xxxxN
    config MCUX_HW_DEVICE_PART_MIMX9596DVZXN
    bool "MIMX9596DVZXN"
    select MCUX_HW_DEVICE_ID_MIMX9596xxxxN
    config MCUX_HW_DEVICE_PART_MIMX9596DVTXN
    bool "MIMX9596DVTXN"
    select MCUX_HW_DEVICE_ID_MIMX9596xxxxN
    config MCUX_HW_DEVICE_PART_MIMX9596CVZXN
    bool "MIMX9596CVZXN"
    select MCUX_HW_DEVICE_ID_MIMX9596xxxxN
    config MCUX_HW_DEVICE_PART_MIMX9596CVTXN
    bool "MIMX9596CVTXN"
    select MCUX_HW_DEVICE_ID_MIMX9596xxxxN
    config MCUX_HW_DEVICE_PART_MIMX9596DVZXQ
    bool "MIMX9596DVZXQ"
    select MCUX_HW_DEVICE_ID_MIMX9596xxxxQ
endchoice

config MCUX_HW_DEVICE_ID
    string
    default "MIMX9596xxxxQ" if MCUX_HW_DEVICE_ID_MIMX9596xxxxQ
    default "MIMX9596xxxxN" if MCUX_HW_DEVICE_ID_MIMX9596xxxxN
    default "MIMX9596xxxxL" if MCUX_HW_DEVICE_ID_MIMX9596xxxxL

config MCUX_HW_DEVICE_PART
    string
    default "MIMX9596XVZXN" if MCUX_HW_DEVICE_PART_MIMX9596XVZXN
    default "MIMX9596XVTXN" if MCUX_HW_DEVICE_PART_MIMX9596XVTXN
    default "MIMX9596DVZXN" if MCUX_HW_DEVICE_PART_MIMX9596DVZXN
    default "MIMX9596DVTXN" if MCUX_HW_DEVICE_PART_MIMX9596DVTXN
    default "MIMX9596CVZXN" if MCUX_HW_DEVICE_PART_MIMX9596CVZXN
    default "MIMX9596CVTXN" if MCUX_HW_DEVICE_PART_MIMX9596CVTXN
    default "MIMX9596AVZXN" if MCUX_HW_DEVICE_PART_MIMX9596AVZXN
    default "MIMX9596DVZXQ" if MCUX_HW_DEVICE_PART_MIMX9596DVZXQ

