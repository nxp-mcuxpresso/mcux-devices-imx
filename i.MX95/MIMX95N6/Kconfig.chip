# core related
config MCUX_HW_CORE
    string
    default "cm7f"

config MCUX_HW_CORE_CM7F
    bool
    default y

config MCUX_HW_CORE_ID
    string
    default "cm7"

config MCUX_HW_CORE_ID_CM7
    bool
    default y

config MCUX_HW_DEVICE_CORE
    string
    default "MIMX95N6_cm7"

config MCUX_HW_FPU
    string
    default "DP_FPU"

config MCUX_HW_FPU_TYPE
    string
    default "fpv5_dp"

config MCUX_HW_FPV5_DP
    bool
    default y

config MCUX_HW_INT_PRIO_BITS
    int
    default 4

config MCUX_HW_SOC_SERIES_KINETIS
    bool
    default y

# For chipmodel generated files
config MCUX_TOOLCHAIN_LINKER_DEVICE_PREFIX
    string
    default "MIMX95N6xxxxN_cm7" if MCUX_HW_DEVICE_ID_MIMX95N6xxxxN

config MCUX_TOOLCHAIN_MCUX_STARTUP
    string
    default "mimx95N6_cm7"

# Toolchain related

config MCUX_TOOLCHAIN_IAR_CPU_IDENTIFIER
    string
    default "MIMX95N6_M7" if MCUX_HW_DEVICE_ID_MIMX95N6xxxxN

config MCUX_TOOLCHAIN_MDK_CPU_IDENTIFIER
    string
    default "MIMX95N6XVZXN:cm7" if MCUX_HW_DEVICE_PART_MIMX95N6XVZXN
    default "MIMX95N6XVTXN:cm7" if MCUX_HW_DEVICE_PART_MIMX95N6XVTXN
    default "MIMX95N6DVZXN:cm7" if MCUX_HW_DEVICE_PART_MIMX95N6DVZXN
    default "MIMX95N6DVTXN:cm7" if MCUX_HW_DEVICE_PART_MIMX95N6DVTXN
    default "MIMX95N6CVZXN:cm7" if MCUX_HW_DEVICE_PART_MIMX95N6CVZXN
    default "MIMX95N6CVYXN:cm7" if MCUX_HW_DEVICE_PART_MIMX95N6CVYXN
    default "MIMX95N6CVTXN:cm7" if MCUX_HW_DEVICE_PART_MIMX95N6CVTXN
    default "MIMX95N6AVZXN:cm7" if MCUX_HW_DEVICE_PART_MIMX95N6AVZXN
    default "MIMX95N6AVTXN:cm7" if MCUX_HW_DEVICE_PART_MIMX95N6AVTXN
# device related

config MCUX_HW_DEVICE_ID_MIMX95N6xxxxN
    bool

choice MCUX_HW_DEVICE_PART_MIMX95N6
    prompt "Device MIMX95N6 Part"
    config MCUX_HW_DEVICE_PART_MIMX95N6XVZXN
    bool "MIMX95N6XVZXN"
    select MCUX_HW_DEVICE_ID_MIMX95N6xxxxN
    config MCUX_HW_DEVICE_PART_MIMX95N6XVTXN
    bool "MIMX95N6XVTXN"
    select MCUX_HW_DEVICE_ID_MIMX95N6xxxxN
    config MCUX_HW_DEVICE_PART_MIMX95N6DVZXN
    bool "MIMX95N6DVZXN"
    select MCUX_HW_DEVICE_ID_MIMX95N6xxxxN
    config MCUX_HW_DEVICE_PART_MIMX95N6DVTXN
    bool "MIMX95N6DVTXN"
    select MCUX_HW_DEVICE_ID_MIMX95N6xxxxN
    config MCUX_HW_DEVICE_PART_MIMX95N6CVZXN
    bool "MIMX95N6CVZXN"
    select MCUX_HW_DEVICE_ID_MIMX95N6xxxxN
    config MCUX_HW_DEVICE_PART_MIMX95N6CVYXN
    bool "MIMX95N6CVYXN"
    select MCUX_HW_DEVICE_ID_MIMX95N6xxxxN
    config MCUX_HW_DEVICE_PART_MIMX95N6CVTXN
    bool "MIMX95N6CVTXN"
    select MCUX_HW_DEVICE_ID_MIMX95N6xxxxN
    config MCUX_HW_DEVICE_PART_MIMX95N6AVZXN
    bool "MIMX95N6AVZXN"
    select MCUX_HW_DEVICE_ID_MIMX95N6xxxxN
    config MCUX_HW_DEVICE_PART_MIMX95N6AVTXN
    bool "MIMX95N6AVTXN"
    select MCUX_HW_DEVICE_ID_MIMX95N6xxxxN
endchoice

config MCUX_HW_DEVICE_ID
    string
    default "MIMX95N6xxxxN" if MCUX_HW_DEVICE_ID_MIMX95N6xxxxN

config MCUX_HW_DEVICE_PART
    string
    default "MIMX95N6XVZXN" if MCUX_HW_DEVICE_PART_MIMX95N6XVZXN
    default "MIMX95N6XVTXN" if MCUX_HW_DEVICE_PART_MIMX95N6XVTXN
    default "MIMX95N6DVZXN" if MCUX_HW_DEVICE_PART_MIMX95N6DVZXN
    default "MIMX95N6DVTXN" if MCUX_HW_DEVICE_PART_MIMX95N6DVTXN
    default "MIMX95N6CVZXN" if MCUX_HW_DEVICE_PART_MIMX95N6CVZXN
    default "MIMX95N6CVYXN" if MCUX_HW_DEVICE_PART_MIMX95N6CVYXN
    default "MIMX95N6CVTXN" if MCUX_HW_DEVICE_PART_MIMX95N6CVTXN
    default "MIMX95N6AVZXN" if MCUX_HW_DEVICE_PART_MIMX95N6AVZXN
    default "MIMX95N6AVTXN" if MCUX_HW_DEVICE_PART_MIMX95N6AVTXN

