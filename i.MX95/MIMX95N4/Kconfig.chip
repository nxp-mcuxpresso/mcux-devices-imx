# core related
config MCUX_HW_CORE
    string
    default "cm7f"

config MCUX_HW_CORE_CM7F
    bool
    default y

config MCUX_HW_CORE_ID
    string
    default "cm7"

config MCUX_HW_CORE_ID_CM7
    bool
    default y

config MCUX_HW_DEVICE_CORE
    string
    default "MIMX95N4_cm7"

config MCUX_HW_FPU
    string
    default "DP_FPU"

config MCUX_HW_FPU_TYPE
    string
    default "fpv5_dp"

config MCUX_HW_FPV5_DP
    bool
    default y

config MCUX_HW_INT_PRIO_BITS
    int
    default 4

config MCUX_HW_SOC_SERIES_KINETIS
    bool
    default y

# For chipmodel generated files
config MCUX_TOOLCHAIN_LINKER_DEVICE_PREFIX
    string
    default "MIMX95N4xxxxN_cm7" if MCUX_HW_DEVICE_ID_MIMX95N4xxxxN

config MCUX_TOOLCHAIN_MCUX_STARTUP
    string
    default "mimx95N4_cm7"

# Toolchain related

config MCUX_TOOLCHAIN_IAR_CPU_IDENTIFIER
    string
    default "MIMX95N4_M7" if MCUX_HW_DEVICE_ID_MIMX95N4xxxxN

config MCUX_TOOLCHAIN_MDK_CPU_IDENTIFIER
    string
    default "MIMX95N4XVZXN:cm7" if MCUX_HW_DEVICE_PART_MIMX95N4XVZXN
    default "MIMX95N4XVTXN:cm7" if MCUX_HW_DEVICE_PART_MIMX95N4XVTXN
    default "MIMX95N4DVZXN:cm7" if MCUX_HW_DEVICE_PART_MIMX95N4DVZXN
    default "MIMX95N4DVTXN:cm7" if MCUX_HW_DEVICE_PART_MIMX95N4DVTXN
    default "MIMX95N4CVZXN:cm7" if MCUX_HW_DEVICE_PART_MIMX95N4CVZXN
    default "MIMX95N4CVTXN:cm7" if MCUX_HW_DEVICE_PART_MIMX95N4CVTXN
    default "MIMX95N4AVZXN:cm7" if MCUX_HW_DEVICE_PART_MIMX95N4AVZXN
    default "MIMX95N4AVTXN:cm7" if MCUX_HW_DEVICE_PART_MIMX95N4AVTXN
# device related

config MCUX_HW_DEVICE_ID_MIMX95N4xxxxN
    bool

choice MCUX_HW_DEVICE_PART_MIMX95N4
    prompt "Device MIMX95N4 Part"
    config MCUX_HW_DEVICE_PART_MIMX95N4XVZXN
    bool "MIMX95N4XVZXN"
    select MCUX_HW_DEVICE_ID_MIMX95N4xxxxN
    config MCUX_HW_DEVICE_PART_MIMX95N4XVTXN
    bool "MIMX95N4XVTXN"
    select MCUX_HW_DEVICE_ID_MIMX95N4xxxxN
    config MCUX_HW_DEVICE_PART_MIMX95N4DVZXN
    bool "MIMX95N4DVZXN"
    select MCUX_HW_DEVICE_ID_MIMX95N4xxxxN
    config MCUX_HW_DEVICE_PART_MIMX95N4DVTXN
    bool "MIMX95N4DVTXN"
    select MCUX_HW_DEVICE_ID_MIMX95N4xxxxN
    config MCUX_HW_DEVICE_PART_MIMX95N4CVZXN
    bool "MIMX95N4CVZXN"
    select MCUX_HW_DEVICE_ID_MIMX95N4xxxxN
    config MCUX_HW_DEVICE_PART_MIMX95N4CVTXN
    bool "MIMX95N4CVTXN"
    select MCUX_HW_DEVICE_ID_MIMX95N4xxxxN
    config MCUX_HW_DEVICE_PART_MIMX95N4AVZXN
    bool "MIMX95N4AVZXN"
    select MCUX_HW_DEVICE_ID_MIMX95N4xxxxN
    config MCUX_HW_DEVICE_PART_MIMX95N4AVTXN
    bool "MIMX95N4AVTXN"
    select MCUX_HW_DEVICE_ID_MIMX95N4xxxxN
endchoice

config MCUX_HW_DEVICE_ID
    string
    default "MIMX95N4xxxxN" if MCUX_HW_DEVICE_ID_MIMX95N4xxxxN

config MCUX_HW_DEVICE_PART
    string
    default "MIMX95N4XVZXN" if MCUX_HW_DEVICE_PART_MIMX95N4XVZXN
    default "MIMX95N4XVTXN" if MCUX_HW_DEVICE_PART_MIMX95N4XVTXN
    default "MIMX95N4DVZXN" if MCUX_HW_DEVICE_PART_MIMX95N4DVZXN
    default "MIMX95N4DVTXN" if MCUX_HW_DEVICE_PART_MIMX95N4DVTXN
    default "MIMX95N4CVZXN" if MCUX_HW_DEVICE_PART_MIMX95N4CVZXN
    default "MIMX95N4CVTXN" if MCUX_HW_DEVICE_PART_MIMX95N4CVTXN
    default "MIMX95N4AVZXN" if MCUX_HW_DEVICE_PART_MIMX95N4AVZXN
    default "MIMX95N4AVTXN" if MCUX_HW_DEVICE_PART_MIMX95N4AVTXN

