# core related
config MCUX_HW_CORE
    string
    default "cm33"

config MCUX_HW_CORE_CM33
    bool
    default y

config MCUX_HW_CORE_ID
    string
    default "cm33"

config MCUX_HW_CORE_ID_CM33
    bool
    default y

config MCUX_HW_DEVICE_CORE
    string
    default "MIMX9529_cm33"

config MCUX_HW_FPU
    string
    default "SP_FPU"

config MCUX_HW_FPU_TYPE
    string
    default "fpv5_sp"

config MCUX_HW_FPV5_SP
    bool
    default y

config MCUX_HW_INT_PRIO_BITS
    int
    default 4

config MCUX_HW_DSP
    bool
    default y

config MCUX_HW_SAU
    bool
    default y

config MCUX_HW_SOC_SERIES_MIMX
    bool
    default y

# For chipmodel generated files
config MCUX_TOOLCHAIN_LINKER_DEVICE_PREFIX
    string
    default "MIMX9529_cm33" if MCUX_HW_DEVICE_ID_MIMX9529xxxxx

config MCUX_TOOLCHAIN_MCUX_STARTUP
    string
    default "mimx9529_cm33"

# Toolchain related
config MCUX_TOOLCHAIN_IAR_CPU_IDENTIFIER
    string
    default "MIMX9529_M33" if MCUX_HW_DEVICE_ID_MIMX9529xxxxx

config MCUX_TOOLCHAIN_MDK_CPU_IDENTIFIER
    string
    default "MIMX9529xxVZx:cm33" if MCUX_HW_DEVICE_PART_MIMX9529xxVZx
    default "MIMX9529xxVTx:cm33" if MCUX_HW_DEVICE_PART_MIMX9529xxVTx
