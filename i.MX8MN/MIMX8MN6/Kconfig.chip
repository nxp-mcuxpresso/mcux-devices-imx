# product related

config MCUX_HW_SOC_SERIES_MIMX
    bool
    default y

config MCUX_HW_SOC_MULTICORE_DEVICE
    bool
    default y

# device related

config MCUX_HW_DEVICE_ID_MIMX8MN6xxxIZ
    bool

config MCUX_HW_DEVICE_ID_MIMX8MN6xxxJZ
    bool

choice MCUX_HW_DEVICE_PART_MIMX8MN6
    prompt "Device MIMX8MN6 Part"
    config MCUX_HW_DEVICE_PART_MIMX8MN6CVTIZ
    bool "MIMX8MN6CVTIZ"
    select MCUX_HW_DEVICE_ID_MIMX8MN6xxxIZ
    config MCUX_HW_DEVICE_PART_MIMX8MN6DVTJZ
    bool "MIMX8MN6DVTJZ"
    select MCUX_HW_DEVICE_ID_MIMX8MN6xxxJZ
endchoice

config MCUX_HW_DEVICE_ID
    string
    default "MIMX8MN6xxxIZ" if MCUX_HW_DEVICE_ID_MIMX8MN6xxxIZ
    default "MIMX8MN6xxxJZ" if MCUX_HW_DEVICE_ID_MIMX8MN6xxxJZ

config MCUX_HW_DEVICE_PART
    string
    default "MIMX8MN6CVTIZ" if MCUX_HW_DEVICE_PART_MIMX8MN6CVTIZ
    default "MIMX8MN6DVTJZ" if MCUX_HW_DEVICE_PART_MIMX8MN6DVTJZ

