# core related

config MCUX_HW_CORE
    string
    default "ca53"

config MCUX_HW_CORE_CA53
    bool
    default y

config MCUX_HW_CORE_ID
    string
    default "ca53"

config MCUX_HW_CORE_ID_CA53
    bool
    default y

config MCUX_HW_DSP
    bool
    default n

config MCUX_HW_MPU
    bool
    default n

config MCUX_HW_FPU
    string
    default "SP_FPU"

config MCUX_HW_FPU_TYPE
    string
    default "fpv4_sp"

config MCUX_HW_FPV4_SP
    bool
    default y

config MCUX_HW_SAU
    bool
    default n

config MCUX_HW_INT_PRIO_BITS
    int
    default 5

# device related

config MCUX_HW_DEVICE_CORE
    string
    default "MIMX8MN5_ca53"

# core-specific ip information

config MCUX_HW_IP_DriverType_CACHE
    bool
    default y
    depends on MCUX_HW_DEVICE_ID_MIMX8MN5xxxJZ

